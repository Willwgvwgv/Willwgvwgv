rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/agenda_profiles/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/agenda_profiles/$(request.auth.uid))
        ? getUserData().role
        : 'none';
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isComercial() {
      return isSignedIn() && getUserRole() == 'comercial';
    }

    function isAgendador() {
      return isSignedIn() && getUserRole() == 'agendador';
    }

    function isFinanceiro() {
      return isSignedIn() && getUserRole() == 'financeiro';
    }

    // PROFILES
    match /agenda_profiles/{userId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // SLOT LOCKS (Garante reserva única sem duplicidade de horário)
    match /agenda_slot_locks/{slotKey} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/agenda_slot_locks/$(slotKey))
                    && request.resource.data.keys().hasOnly(['slotKey', 'appointmentId', 'createdAt'])
                    && request.resource.data.slotKey == slotKey;
      allow update, delete: if isAdmin() || isAgendador();
    }

    // APPOINTMENTS (AGENDAMENTOS)
    match /agenda_appointments/{appointmentId} {
      // Público NUNCA pode ler ou listar reuniões existentes
      allow read: if isAdmin() || isAgendador() || isFinanceiro() || (isComercial() && resource.data.assignedTo == request.auth.uid);

      // Criação protegida: Público com validações estritas / Autenticados por perfil
      allow create: if (
        // Criação pública (agendamento-público sem login)
        (request.auth == null
          && request.resource.data.keys().hasOnly(['clientName', 'clientEmail', 'clientPhone', 'date', 'time', 'planId', 'notes', 'status', 'createdAt', 'assignedTo', 'slotKey'])
          && request.resource.data.clientName is string && request.resource.data.clientName.size() >= 2 && request.resource.data.clientName.size() <= 100
          && request.resource.data.clientEmail is string && request.resource.data.clientEmail.matches('.*@.*') && request.resource.data.clientEmail.size() <= 100
          && request.resource.data.clientPhone is string && request.resource.data.clientPhone.size() >= 8 && request.resource.data.clientPhone.size() <= 20
          && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.time is string && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
          && request.resource.data.status == 'pending'
          && request.resource.data.slotKey == request.resource.data.date + '_' + request.resource.data.time + '_' + request.resource.data.assignedTo
          && exists(/databases/$(database)/documents/agenda_slot_locks/$(request.resource.data.slotKey))
        )
        ||
        // Criação por usuários autenticados conforme perfil
        (isAdmin() || isAgendador())
        ||
        (isComercial() && request.resource.data.assignedTo == request.auth.uid)
      );

      allow update, delete: if isAdmin() || isAgendador() || (isComercial() && resource.data.assignedTo == request.auth.uid);
    }

    // SALES (VENDAS E COMISSÕES)
    match /agenda_sales/{saleId} {
      allow read: if isAdmin() || isFinanceiro() || (isComercial() && resource.data.sellerId == request.auth.uid);
      allow create, update: if isAdmin() || isFinanceiro() || (isComercial() && request.resource.data.sellerId == request.auth.uid);
      allow delete: if isAdmin() || isFinanceiro();
    }

    // AUDIT HISTORY (HISTÓRICO) - Sem criação pública!
    match /agenda_history/{historyId} {
      allow read: if isAdmin() || isFinanceiro() || isAgendador() || (isComercial() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // NOTIFICATIONS
    match /agenda_notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // PLANS
    match /agenda_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AVAILABILITY
    match /agenda_availability/{availabilityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // BLOCKED DATES
    match /agenda_blocked_dates/{blockedId} {
      allow read: if true;
      allow write: if isAdmin() || isAgendador();
    }
  }
}
